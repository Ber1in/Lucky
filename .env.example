# PostgreSQL
POSTGRES_DB=dlt
POSTGRES_USER=dlt
POSTGRES_PASSWORD=change-me

# 后端连接串（host 用 compose 服务名 db）
DATABASE_URL=postgresql+psycopg://dlt:change-me@db:5432/dlt

# 会话签名/哈希使用的密钥，生产环境务必改成长随机串
SECRET_KEY=please-change-this-to-a-long-random-string

# 宿主机暴露的 Web 端口（NAS 上 8080 常被占用，可改成 18080）
WEB_PORT=8080

# 国内网络可改用镜像源（默认走官方源）
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# NODE_IMAGE=docker.m.daocloud.io/library/node:22-alpine
# NGINX_IMAGE=docker.m.daocloud.io/library/nginx:1.27-alpine
# POSTGRES_IMAGE=docker.m.daocloud.io/library/postgres:16-alpine
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# NPM_REGISTRY=https://registry.npmmirror.com
